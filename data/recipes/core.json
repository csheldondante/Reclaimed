  "rules": [
    { "id": "housing", "when": { "all": ["structure", "has:room"], "none": ["civic"] }, "tags": ["housing"], "add": { "beds": 4 } },
    { "id": "tower-homes", "when": { "all": ["tall", "has:room"] }, "add": { "beds": 12 } },
