    { "id": "civic", "when": { "all": ["civic", "large"] }, "tags": ["meeting-hall"], "abilities": ["muster"] },
    { "id": "shrine", "when": { "all": ["fitting:shrine"] }, "tags": ["temple"] },
    { "id": "defence", "when": { "any": ["fortification"] }, "tags": ["defence"], "add": { "defence": 5 } },
    { "id": "farmland", "when": { "all": ["farmland"] }, "tags": ["farm"], "add": { "grain": 2 } },
    { "id": "ruin-unmet", "when": { "all": ["ancient", "structure"], "none": ["has:room"] }, "unmet": "a ruin: nobody lives in it until it's adapted" },
    { "id": "worker", "when": { "all": ["person"] }, "abilities": ["work"] }
  ]
